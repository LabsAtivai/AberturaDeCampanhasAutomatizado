# Sistema de credenciais (snov-am-api) — URL interna em produção (rede docker "ativaai"),
# http://localhost:8000 (ou porta publicada) em dev local.
CREDENTIALS_API_URL=

# API key gerada em POST /api/api-keys no sistema de credenciais (snov-am-api),
# com scopes accounts:read e credentials:read.
CREDENTIALS_API_KEY=

# MySQL (ativa.live)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=extensao
